filters:
  and:
    - 'tipo == "projeto"'
    - not:
        - file.inFolder("00-Sistema")
properties:
  nome:
    displayName: Nome
views:
  - type: table
    name: Projetos
    order:
      - file.name
      - nome
      - status
      - cliente
      - stack
      - caminhos
  - type: cards
    name: Cartões
    order:
      - nome
      - status
      - cliente
